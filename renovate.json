{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "finance-mcp: beancount publishes wheels up to CPython 3.14 only; lift once a cp315 wheel exists",
      "matchFileNames": [
        "finance-mcp/Dockerfile"
      ],
      "matchDepNames": [
        "python"
      ],
      "allowedVersions": "<3.15"
    }
  ]
}
